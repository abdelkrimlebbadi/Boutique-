# Supabase project (see https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL, used for metadata/sitemap/hreflang/JSON-LD absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed server-side for privileged operations (checkout, webhooks,
# admin mutations). Never exposed to the browser — do not prefix with
# NEXT_PUBLIC_. Also required as GitHub Actions secrets
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY) for
# .github/workflows/fetch-fx-rates.yml.
SUPABASE_SERVICE_ROLE_KEY=
