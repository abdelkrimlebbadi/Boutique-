# Supabase project (see https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL, used for metadata/sitemap/hreflang/JSON-LD absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed server-side for privileged operations (checkout, webhooks,
# admin mutations). Never exposed to the browser — do not prefix with
# NEXT_PUBLIC_. Also required as GitHub Actions secrets
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY) for
# .github/workflows/fetch-fx-rates.yml AND deploy.yml.
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider selection (src/lib/payments/select-provider.ts). Leave
# unset to auto-select by shipping country (MA -> youcan_pay, else paypal).
# Set to "mock" for local dev/demo — the only path fully testable without
# real provider credentials (see /checkout/mock-pay).
PAYMENT_PROVIDER=

# PayPal Orders API v2 (src/lib/paypal/).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# YouCan Pay (src/lib/youcan-pay/) — LOW CONFIDENCE integration, unverified
# against live docs in this environment. Do not enable in production
# without validating against a real sandbox account first.
YOUCAN_PAY_PUBLIC_KEY=
YOUCAN_PAY_SECRET_KEY=
YOUCAN_PAY_WEBHOOK_SECRET=
YOUCAN_PAY_API_BASE=https://youcanpay.com/api

# Mock payment provider webhook signing (local dev/demo only).
MOCK_WEBHOOK_SECRET=

# Printful order fulfillment (src/lib/printful/).
PRINTFUL_API_KEY=
# Shared-secret query token on the registered webhook URL
# (/api/webhooks/printful?token=...) — defense-in-depth alongside whatever
# official signature verification Printful provides.
PRINTFUL_WEBHOOK_SECRET=

# Resend transactional emails (src/lib/resend/).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin back-office (/admin, src/app/admin/, src/lib/admin/). Shared
# secret required once to bootstrap the first admin account at
# /admin/setup — after that account exists, /admin/setup permanently
# refuses further use (see bootstrap_admin_if_empty). Generate a long
# random value, e.g. `openssl rand -hex 32`.
ADMIN_BOOTSTRAP_SECRET=
